__pycache__/
*.pyc
*.dll
*.obj
*.log
bin/
obj/
lib/

# extracted Driver 1 geometry is a build artifact, not source - regenerate it
# with tools/ (see docs/DRIVER1.md); the pool index is committed, the shapes are
# not.
tools/out/

# The module's own MSVC by-products: obj/ and lib/ are covered above, these are
# the export/link files that sit beside them in the repo root.
*.exp
*.lib
*.pdb

# Pipeline output directories (tools/car and tools/ped write previews, rebuilt
# pages and per-character scratch here).
tools/car/out/
tools/ped/out/
tools/ped/characters/
tools/ped/project.json
