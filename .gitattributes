# Line endings. The repository stores LF; a checkout gets the platform's own (CRLF
# on Windows). Without this a Windows checkout and a Linux/WSL one disagree about
# every text file, and `git status` lists hundreds that differ only in CR.
* text=auto

# cmd.exe mis-reads labels and GOTO in an LF batch file; a shell script with CR
# fails under bash. These two keep their endings wherever they are checked out.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

